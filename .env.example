# =============================================================================
# ExpressiveAI.online — Environment Variables Reference
# =============================================================================
# Copy values into app-specific env files. Never commit real credentials.
# =============================================================================

# Supabase (API + worker)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-public-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<key>
CLERK_SECRET_KEY=sk_test_<key>
CLERK_ISSUER=https://<your-clerk-domain>
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_<key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe (API + web)
STRIPE_SECRET_KEY=sk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>

# Redis / BullMQ (API + worker)
REDIS_URL=rediss://default:<password>@<host>:6379

# Hugging Face Inference Providers (worker)
HF_TOKEN=hf_<token-with-inference-providers-permission>
HUGGINGFACE_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B

# Supabase Storage (worker)
STORAGE_BUCKET=videos
STORAGE_CDN_URL=https://cdn.example.com

# API server
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional transactional email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_<key>
EMAIL_FROM=noreply@example.com
